{
  "name": "supportdesk-workspace",
  "version": "1.0.0",
  "description": "SupportDesk - Full-Stack Customer Support CRM",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:frontend",
    "seed": "npm --prefix backend run prisma:seed",
    "test:backend": "npm --prefix backend test",
    "test": "npm run test:backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
